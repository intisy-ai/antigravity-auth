{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Compiled from the submodules, not installed, so each specifier maps to the
    // built output it resolves to at runtime.
    "paths": { "@intisy-ai/core": ["./core/dist/index.d.ts"], "@intisy-ai/core-auth": ["./core-auth/dist/index.d.ts"] },
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  },
  "include": ["src/**/*", "claude/**/*", "opencode/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
