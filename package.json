{
  "name": "antigravity-auth",
  "version": "1.17.4",
  "description": "Google Antigravity provider for OpenCode and Claude Code, built on core-auth (multi-account rotation, quota management, proxy support)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "antigravity": "dist/cli.js"
  },
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/antigravity-auth.git"
  },
  "keywords": [
    "opencode",
    "claude",
    "antigravity",
    "google",
    "oauth",
    "gemini",
    "core-auth",
    "provider"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "plugin.json",
    "cairn.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "claudeHub": {
    "authProviders": [
      {
        "name": "antigravity",
        "handler": "dist/handler.js",
        "models": [],
        "accountPool": "antigravity"
      },
      {
        "name": "gemini-cli",
        "handler": "dist/handler.js",
        "models": [],
        "accountPool": "antigravity"
      }
    ]
  },
  "scripts": {
    "build": "node node_modules/@intisy-ai/api/scripts/teavm-build.mjs --java-dir . --module :antigravity-teavm --out src/generated/antigravity-orchestrator.teavm.js && node build.mjs",
    "postbuild": "node dist/index.js readme",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@intisy-ai/core": "^2.0.0",
    "@intisy-ai/core-auth": "^1.4.0",
    "@intisy-ai/core-ir": "^1.0.3",
    "@openauthjs/openauth": "^0.4.3"
  },
  "devDependencies": {
    "@intisy-ai/api": "^1.0.2",
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
